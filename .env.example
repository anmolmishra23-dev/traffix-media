# Copy this file to .env.local and fill in the values.
# Supabase Dashboard → Project Settings → API (Data API) / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The live website address (used for SEO: sitemap, canonical URLs, social previews)
NEXT_PUBLIC_SITE_URL=https://traffixmedia.in

# Only used by `npm run db:setup` to create tables (never exposed to the website)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
